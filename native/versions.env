# Pinned native sources for jAirspyHF releases. Sourced by the build scripts and
# read by the GitHub workflows. To move to a new upstream release, change these
# values and open a pull request.
#
# AIRSPYHF_REF is the upstream tag or full commit to build. Upstream's last tag
# is 1.6.8, from 2020; later releases, such as 1.8.1 with Ranger support, exist
# only as version bumps on master, so they are pinned by commit.
# AIRSPYHF_VERSION must equal AIRSPYHF_VERSION in airspyhf.h at that ref, which
# the build checks. It is also the jAirspyHF version.
AIRSPYHF_REPOSITORY=https://github.com/airspy/airspyhf.git
AIRSPYHF_REF=24fe8ffcb00b14f827268bbad89ae1392de055e5
AIRSPYHF_VERSION=1.8.1
LIBUSB_VERSION=1.0.30
LIBUSB_TARBALL_SHA256=fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
LIBUSB_WINDOWS_7Z_SHA256=7fb1dfec805b97983763d7d0ae244320da12add1003d4249c96cc4d586398c79
# Windows only: libairspyhf uses POSIX threads. Commit of tag Version-3-0-0-release.
PTHREADS4W_REPOSITORY=https://github.com/jwinarske/pthreads4w.git
PTHREADS4W_REF=07053a521b0a9deb6db2a649cde1f828f2eb1f4f
